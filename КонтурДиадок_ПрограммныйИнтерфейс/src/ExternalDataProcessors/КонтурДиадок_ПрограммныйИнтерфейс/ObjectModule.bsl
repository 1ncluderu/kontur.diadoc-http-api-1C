// Возвращает структуру с данными организации для настройки интеграции.
//
// Возвращаемое значение:
//   Структура - данные организации:
//     * ОтпечатокСертификата - Неопределено - отпечаток сертификата
//     * ПарольСертификата - Неопределено - пароль к закрытому ключу сертификата
//     * АвторизацияOIDC - Булево - признак использования авторизации OIDC
//     * ДанныеАвторизацииOIDC - Структура - данные авторизации OIDC:
//         ** refresh_token - Неопределено - токен обновления
//         ** client_id - Неопределено - идентификатор клиента
//         ** client_secret - Неопределено - секрет клиента
//     * КлючРазработчика - Неопределено - ключ разработчика (для устаревшего варианта авторизации)
//     * ИдентификаторЯщика - Неопределено - идентификатор ящика
//     * ИНН - Неопределено - ИНН организации
Функция Контракт_ORGANIZATION_INFO() Экспорт

	ДанныеАвторизацииOIDC = Новый Структура();
	ДанныеАвторизацииOIDC.Вставить("refresh_token", Неопределено);
	ДанныеАвторизацииOIDC.Вставить("client_id", Неопределено);
	ДанныеАвторизацииOIDC.Вставить("client_secret", Неопределено);

	НовыйКонтракт = Новый Структура();
	НовыйКонтракт.Вставить("ОтпечатокСертификата", Неопределено);
	НовыйКонтракт.Вставить("ПарольСертификата", Неопределено);
	НовыйКонтракт.Вставить("АвторизацияOIDC", Истина); // Актуальный на данный момент
	НовыйКонтракт.Вставить("ДанныеАвторизацииOIDC", ДанныеАвторизацииOIDC);
	НовыйКонтракт.Вставить("КлючРазработчика", Неопределено); // Для устаревшего варианта авторизации
	НовыйКонтракт.Вставить("ИдентификаторЯщика", Неопределено);

	НовыйКонтракт.Вставить("ИНН", Неопределено);

	Возврат НовыйКонтракт;

КонецФункции

