// Возвращает зашифрованный токен аутентификации по сертификату (устаревший способ авторизации).
//
// Возвращаемое значение:
//   Структура - результат выполнения:
//     * Успешно - Булево - Истина, если запрос выполнен успешно
//     * ПредставлениеПользователю - Строка - текст сообщения для пользователя
//     * Данные - Произвольный, Неопределено - токен аутентификации в виде Base64-строки
Функция V3_Authenticate()

	Параметры = НовыеПараметрыМетода(Base64Строка(CURRENT_CERTIFICATE.Выгрузить()));
	Параметры.Заголовки.Вставить("Content-Type", "application/octet-stream");

	ДобавитьЗаголовокАвторизации(Параметры.Заголовки, Истина);

	Результат = Модуль_КоннекторHTTP.Post(СтрШаблон("%1%2", АдресДиадокAPI(), "/v3/Authenticate?type=certificate"),
		Неопределено, Параметры, СессияКоннектор);

	Если Не УспешноВыполненМетодHTTP(Результат) Тогда
		Возврат РезультатВыполненияМетода(Ложь, Модуль_КоннекторHTTP.КакТекст(Результат));
	КонецЕсли;

	Возврат РезультатВыполненияМетода(Истина, "Выполнен успешно", 
		Base64Строка(МенеджерКриптографии_Расшифровать(Результат.Тело)));
	
КонецФункции

