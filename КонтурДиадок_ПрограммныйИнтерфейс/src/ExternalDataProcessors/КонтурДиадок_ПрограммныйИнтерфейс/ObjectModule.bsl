// Возвращает или создает роуминговую организацию по идентификатору участника ЭДО.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса:
//     * ИдентификаторУчастникаЭДО - Строка - идентификатор участника ЭДО
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода
Функция РоуминговаяОрганизацияПоИдентификаторуУчастникаЭДО(ПараметрыМетода) Экспорт
	
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;
	
	FnsParticipantId = СокрЛП(ПараметрыМетода.ИдентификаторУчастникаЭДО);
	Если ВРег(Лев(FnsParticipantId, 3)) = "2BM" Тогда
		Возврат РезультатВыполненияМетода(Ложь, "Передан идентификатор текущего оператора ЭДО.");
	КонецЕсли;
	
	ТелоЗапроса = Новый Структура("FnsParticipantId", FnsParticipantId);
	Возврат GetOrCreateRoamingOrganizationByFnsParticipantId(ТелоЗапроса);
	
КонецФункции

