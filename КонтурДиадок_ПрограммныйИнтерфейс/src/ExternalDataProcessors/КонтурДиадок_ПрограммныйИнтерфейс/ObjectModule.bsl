#Область ПоискКонтрагентов_Организаций

// Возвращает организацию, найденную по одному из указанных идентификаторов.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса. Достаточно указать один из идентификаторов:
//     * ИдентификаторОрганизации - Строка - (необязательный) идентификатор организации
//     * ИдентификаторЯщика - Строка - (необязательный) идентификатор ящика
//     * ИдентификаторУчастникаЭДО - Строка - (необязательный) идентификатор участника ЭДО
//     * ИНН - Строка - (необязательный) ИНН организации
//     * КПП - Строка - (необязательный) КПП организации, используется вместе с ИНН
//     * КодИностранногоНалогоПлательщика - Строка - (необязательный) код иностранного налогоплательщика
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода
Функция Организация(ПараметрыМетода) Экспорт
	
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;
	
	orgId = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИдентификаторОрганизации", Неопределено);
	boxId = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИдентификаторЯщика", Неопределено);
	fnsParticipantId = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИдентификаторУчастникаЭДО", Неопределено);
	inn = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИНН", Неопределено);
	kpp = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "КПП", Неопределено);
	foreignTaxpayerCode = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "КодИностранногоНалогоПлательщика", Неопределено);
	
	Если ЗначениеЗаполнено(orgId) Тогда
		
		РезультатВыполнения = GetOrganization(orgId, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
		
	ИначеЕсли ЗначениеЗаполнено(boxId) Тогда
		
		РезультатВыполнения = GetOrganization(Неопределено, boxId, Неопределено, Неопределено, Неопределено, Неопределено);
		 
	ИначеЕсли ЗначениеЗаполнено(fnsParticipantId) Тогда
		
		РезультатВыполнения = GetOrganization(Неопределено, Неопределено, fnsParticipantId, Неопределено, Неопределено, Неопределено);
		
	ИначеЕсли ЗначениеЗаполнено(inn) Тогда
		
		РезультатВыполнения = GetOrganization(Неопределено, Неопределено, Неопределено, inn, kpp, Неопределено);
		
	ИначеЕсли ЗначениеЗаполнено(foreignTaxpayerCode) Тогда
		
		РезультатВыполнения = GetOrganization(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, foreignTaxpayerCode);
		
	Иначе
		
		РезультатВыполнения = РезультатВыполненияМетода(Ложь, "Неверные параметры метода");
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;	
	
КонецФункции

// Возвращает организации, найденные по ИНН и КПП.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса:
//     * ИНН - Строка - ИНН организации
//     * КПП - Строка - (необязательный) КПП организации
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода
Функция ОрганизацииПоИннКпп(ПараметрыМетода) Экспорт
	
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;
	
	inn = ПараметрыМетода.ИНН;
	kpp = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "КПП", Неопределено);
	
	Возврат GetOrganizationsByInnKpp(inn, kpp);
	
КонецФункции

// Возвращает организации по списку ИНН.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса:
//     * ИНН - Строка, Массив из Строка - ИНН организации или список ИНН
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода
Функция ОрганизацииПоИНН(ПараметрыМетода) Экспорт
	
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;
	
	ПереченьИНН = ПараметрыМетода.ИНН;
	Если ТипЗнч(ПереченьИНН) <> Тип("Массив") Тогда
		ПереченьИНН = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыМетода.ИНН);
	КонецЕсли;
	
	ТелоЗапроса = Новый Структура("InnList", ПереченьИНН);
	
	Возврат V2_GetOrganizationsByInnList(ТелоЗапроса);
	
КонецФункции

