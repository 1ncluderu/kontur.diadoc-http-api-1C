КонецФункции

// Возвращает сертификат из хранилища по его отпечатку.
//
// Параметры:
//   ОтпечатокСертификата - Строка, ДвоичныеДанные - отпечаток сертификата
//
// Возвращаемое значение:
//   СертификатКриптографии - найденный сертификат
//   - Неопределено - если сертификат не найден или не указан отпечаток
Функция МенеджерКриптографии_СертификатПоОтпечатку(Знач ОтпечатокСертификата)
	
	Если ТипЗнч(ОтпечатокСертификата) = Тип("Строка") Тогда
		ОтпечатокСертификата = ПолучитьДвоичныеДанныеИзHexСтроки(ОтпечатокСертификата);
	КонецЕсли;
	
	Если ПустаяСтрока(ОтпечатокСертификата) Тогда
		ЗафиксироватьОшибкуИлиВызватьИсключение("Не указан отпечаток сертификата");
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		МенеджерКриптографии = МенеджерКриптографии_Новый();
		ХранилищеСертификатовКриптографии = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ОтпечатокСертификата);
		
	Исключение
		Сертификат = Неопределено;
	КонецПопытки;
	
	Возврат Сертификат;
	
КонецФункции

// Возвращает сертификаты организации, найденные по ИНН, отсортированные по дате окончания действия.
//
// Параметры:
//   ИНН - Строка - ИНН организации
//
// Возвращаемое значение:
//   ТаблицаЗначений - сертификаты:
//     * Сертификат - СертификатКриптографии - сертификат
//     * ДатаОкончания - Дата - дата окончания действия сертификата
//   - Неопределено - если сертификаты не найдены
Функция МенеджерКриптографии_СертификатыПоИНН(ИНН)
	
	МенеджерКриптографии = МенеджерКриптографии_Новый();
	ХранилищеСертификатовКриптографии = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
		ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	
	СертификатыПоСубъекту = ХранилищеСертификатовКриптографии.НайтиПоСубъекту(ИНН);
	Если СертификатыПоСубъекту.Количество() = 0 Тогда
		ЗафиксироватьОшибкуИлиВызватьИсключение("Неудалось найти сертификаты организации");
		Возврат Неопределено;
	КонецЕсли;
	
	// Заполняем ТаблицаЗначений для сортировки
	Сертификаты = Новый ТаблицаЗначений;
	Сертификаты.Колонки.Добавить("Сертификат");
	Сертификаты.Колонки.Добавить("ДатаОкончания");
	
	Для Каждого Сертификат Из СертификатыПоСубъекту Цикл
		
		НоваяСтрока = Сертификаты.Добавить();
		НоваяСтрока.Сертификат = Сертификат;
		НоваяСтрока.ДатаОкончания = Сертификат.ДатаОкончания;
		
	КонецЦикла;
	
	Сертификаты.Сортировать("ДатаОкончания УБЫВ");
	
	Возврат Сертификаты;
	
КонецФункции

// Возвращает сертификат организации с наиболее поздней датой окончания действия.
//
// Параметры:
//   ИНН - Строка - ИНН организации
//
// Возвращаемое значение:
//   СертификатКриптографии - найденный сертификат
//   - Неопределено - если сертификат не найден
Функция МенеджерКриптографии_СертификатПоИНН(ИНН)
	
	Сертификаты = МенеджерКриптографии_СертификатыПоИНН(ИНН);
	Если Ошибка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ?(Сертификаты.Количество(), Сертификаты[0].Сертификат, Неопределено);
	
КонецФункции

#КонецОбласти

#Область Окружение

// Сбрасывает переменные окружения модуля.
Процедура ОчиститьОкружение()
	
	СессияКоннектор = Неопределено;
	
	CURRENT_ORGANIZATION = Неопределено;
	CURRENT_CERTIFICATE = Неопределено;
	CURRENT_CERTIFICATE_PASSWORD = Неопределено;
	
	CURRENT_ACESS_TOKEN = Неопределено;
	
	ORGANIZATION_INFO = Неопределено;
	
	Ошибка = Ложь;
	ТекстыОшибок = Новый Массив();
	
КонецПроцедуры

// Инициализирует переменные окружения модуля для текущей организации.
Процедура ИнициализироватьОкружение()
	
	// Уже инициализировано
	Если CURRENT_ORGANIZATION = Организация Тогда		
		Возврат;
	КонецЕсли;

	ОчиститьОкружение();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение (НСтр("ru = 'Не указана организация'", ОбщегоНазначения.КодОсновногоЯзыка()));
	КонецЕсли;
	
	CURRENT_ORGANIZATION = Организация;
	
	УстановитьПривилегированныйРежим(Истина);

	CURRENT_ACESS_TOKEN = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		CURRENT_ORGANIZATION, "Контур_ПрограммныйИнтерфейс_ТокенДоступа");

	ORGANIZATION_INFO = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		CURRENT_ORGANIZATION, "Контур_ПрограммныйИнтерфейс_ДанныеОрганизации");

	УстановитьПривилегированныйРежим(Ложь);

	Если CURRENT_ACESS_TOKEN = Неопределено Тогда
		CURRENT_ACESS_TOKEN = Контракт_CURRENT_ACESS_TOKEN();
	КонецЕсли;

	Если ORGANIZATION_INFO = Неопределено Тогда
		ORGANIZATION_INFO = Контракт_ORGANIZATION_INFO();
	КонецЕсли;

	CURRENT_CERTIFICATE_PASSWORD = ORGANIZATION_INFO.ПарольСертификата;

	Если ЗначениеЗаполнено(ORGANIZATION_INFO.ОтпечатокСертификата) Тогда

		CURRENT_CERTIFICATE = МенеджерКриптографии_СертификатПоОтпечатку(ORGANIZATION_INFO.ОтпечатокСертификата);

	ИначеЕсли ЗначениеЗаполнено(ORGANIZATION_INFO.ИНН) Тогда

		CURRENT_CERTIFICATE = МенеджерКриптографии_СертификатПоИНН(ORGANIZATION_INFO.ИНН);

	КонецЕсли;

КонецПроцедуры

// Возвращает идентификатор ящика текущей организации.
//
// Возвращаемое значение:
//   Строка - идентификатор ящика
//   - Неопределено - если ящик не найден
Функция ИдентификаторЯщика()
	
	Если Не ЗначениеЗаполнено(ORGANIZATION_INFO.ИдентификаторЯщика) Тогда
		ИдентификаторыЯщиков = ИдентификаторыЯщиков();
		Если ИдентификаторыЯщиков.Успешно
			И ИдентификаторыЯщиков.Данные.Количество() Тогда
			
			ORGANIZATION_INFO.ИдентификаторЯщика = ИдентификаторыЯщиков.Данные[0].ИдентификаторЯщика;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ORGANIZATION_INFO.ИдентификаторЯщика;
	
КонецФункции

#Область Контракты

// Возвращает структуру с данными организации для настройки интеграции.
//
// Возвращаемое значение:
//   Структура - данные организации:
//     * ОтпечатокСертификата - Неопределено - отпечаток сертификата
//     * ПарольСертификата - Неопределено - пароль к закрытому ключу сертификата
//     * АвторизацияOIDC - Булево - признак использования авторизации OIDC
//     * ДанныеАвторизацииOIDC - Структура - данные авторизации OIDC:
//         ** refresh_token - Неопределено - токен обновления
//         ** client_id - Неопределено - идентификатор клиента
//         ** client_secret - Неопределено - секрет клиента
//     * КлючРазработчика - Неопределено - ключ разработчика (для устаревшего варианта авторизации)
//     * ИдентификаторЯщика - Неопределено - идентификатор ящика
//     * ИНН - Неопределено - ИНН организации
Функция Контракт_ORGANIZATION_INFO() Экспорт
	
	ДанныеАвторизацииOIDC = Новый Структура();
	ДанныеАвторизацииOIDC.Вставить("refresh_token", Неопределено);
	ДанныеАвторизацииOIDC.Вставить("client_id", Неопределено);
	ДанныеАвторизацииOIDC.Вставить("client_secret", Неопределено);
	
	НовыйКонтракт = Новый Структура();
	НовыйКонтракт.Вставить("ОтпечатокСертификата", Неопределено);
	НовыйКонтракт.Вставить("ПарольСертификата", Неопределено);
	НовыйКонтракт.Вставить("АвторизацияOIDC", Истина); // Актуальный на данные момент
	НовыйКонтракт.Вставить("ДанныеАвторизацииOIDC", ДанныеАвторизацииOIDC);
	НовыйКонтракт.Вставить("КлючРазработчика", Неопределено); // Для устаревшего варианта авторизации
	НовыйКонтракт.Вставить("ИдентификаторЯщика", Неопределено);
	
	НовыйКонтракт.Вставить("ИНН", Неопределено);
	
	Возврат НовыйКонтракт;
	
КонецФункции

// Возвращает структуру токена доступа с пустыми значениями.
//
// Возвращаемое значение:
//   Структура - токен доступа:
//     * acess_token - Неопределено - токен доступа
//     * expire_date - Дата - дата истечения срока действия токена
Функция Контракт_CURRENT_ACESS_TOKEN()
	
	Возврат Новый Структура("acess_token,expire_date", Неопределено, '00010101');
	
КонецФункции

