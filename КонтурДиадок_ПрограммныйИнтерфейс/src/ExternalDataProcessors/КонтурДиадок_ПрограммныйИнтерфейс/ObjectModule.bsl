// Добавляет в заголовки запроса заголовок авторизации.
//
// Параметры:
//   Заголовки - Соответствие из КлючИЗначение - заголовки запроса, в которые добавляется заголовок Authorization
//   НачальнаяАвторизация - Булево - Истина, если выполняется начальная авторизация по сертификату
Процедура ДобавитьЗаголовокАвторизации(Заголовки, НачальнаяАвторизация = Ложь)
	
	ПараметрыСтроки = Новый Структура();
	
	Если ORGANIZATION_INFO.АвторизацияOIDC Тогда
		
		Шаблон = "Bearer [ACESS_TOKEN]";
		ПараметрыСтроки.Вставить("ACESS_TOKEN", CURRENT_ACESS_TOKEN.acess_token);
		
	Иначе
		
		ПараметрыСтроки.Вставить("DDAUTH_API_CLIENT_ID", ORGANIZATION_INFO.КлючРазработчика);
		Если НачальнаяАвторизация Тогда
			Шаблон = "DiadocAuth ddauth_api_client_id=[DDAUTH_API_CLIENT_ID]";
		Иначе
			ПараметрыСтроки.Вставить("ACESS_TOKEN", CURRENT_ACESS_TOKEN.acess_token);
			Шаблон = "DiadocAuth ddauth_api_client_id=[DDAUTH_API_CLIENT_ID], ddauth_token=[ACESS_TOKEN]";
		КонецЕсли;
		
	КонецЕсли;
	
	Заголовки.Вставить("Authorization", СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыСтроки));
	
КонецПроцедуры

// Проверяет код состояния ответа и при необходимости фиксирует ошибку или вызывает исключение.
//
// Параметры:
//   Результат - Структура - результат HTTP-запроса, содержащий код состояния и тело ответа
Процедура ОбработатьКодСостоянияОтвета(Результат)
	
	Если Результат.КодСостояния <> 200 Тогда
		ЗафиксироватьОшибкуИлиВызватьИсключение(Модуль_КоннекторHTTP.КакТекст(Результат));
	КонецЕсли;
	
КонецПроцедуры

// Фиксирует ошибку или вызывает исключение в зависимости от настройки ВызыватьИсключения.
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки
Процедура ЗафиксироватьОшибкуИлиВызватьИсключение(ТекстОшибки)
	
	Если ВызыватьИсключения Тогда
		ВызватьИсключение ТекстОшибки;
	Иначе
		ЗафиксироватьОшибку(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает параметры HTTP-метода для выполнения запроса через коннектор.
//
// Параметры:
//   Данные - Строка, ДвоичныеДанные - тело запроса
//   Json - Структура - данные для сериализации в JSON
//   ПараметрыЗапроса - Структура - параметры строки запроса
//
// Возвращаемое значение:
//   Структура - параметры метода коннектора HTTP
Функция НовыеПараметрыМетода(Данные = Неопределено, Json = Неопределено, ПараметрыЗапроса = Неопределено)
	
	НовыеПараметрыМетода = Модуль_КоннекторHTTP.НовыеПараметры();
	НовыеПараметрыМетода.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Ложь;
	
	Если Данные <> Неопределено Тогда
		НовыеПараметрыМетода.Данные = Данные;
	КонецЕсли;
	
	Если Json <> Неопределено Тогда
		НовыеПараметрыМетода.Json = Json;
	КонецЕсли;
	
	Если ПараметрыЗапроса <> Неопределено Тогда
		НовыеПараметрыМетода.ПараметрыЗапроса = ПараметрыЗапроса;
	КонецЕсли;
	
	Возврат НовыеПараметрыМетода;
	
КонецФункции

#КонецОбласти

#Область Криптография

// Создает менеджер криптографии с настройками модуля КриптоПро.
//
// Возвращаемое значение:
//   МенеджерКриптографии - менеджер криптографии
Функция МенеджерКриптографии_Новый()
	
	ПутиМодуляКриптографии = Новый Соответствие();
	ПутиМодуляКриптографии.Вставить(ТипПлатформы.Linux_x86, "/opt/cprocsp/lib/ia32/libcapi20.so:/opt/cprocsp/lib/ia32/libcapi10.so");
	ПутиМодуляКриптографии.Вставить(ТипПлатформы.Linux_x86_64, "/opt/cprocsp/lib/amd64/libcapi20.so:/opt/cprocsp/lib/amd64/libcapi10.so");
	ПутиМодуляКриптографии.Вставить(ТипПлатформы.MacOS_x86, "/opt/cprocsp/lib/libcapi20.dylib:/opt/cprocsp/lib/libcapi10.dylib");
	ПутиМодуляКриптографии.Вставить(ТипПлатформы.MacOS_x86_64, "/opt/cprocsp/lib/libcapi20.dylib:/opt/cprocsp/lib/libcapi10.dylib");
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПутьМодуляКриптографии = ПутиМодуляКриптографии[СистемнаяИнформация.ТипПлатформы];
	Если ПутьМодуляКриптографии = Неопределено Тогда
		ПутьМодуляКриптографии = "";
	КонецЕсли;
	
	НовыйМенеджерКриптографии = Новый МенеджерКриптографии("", ПутьМодуляКриптографии, 80, ИспользованиеИнтерактивногоРежимаКриптографии.НеИспользовать);
	
	Если ЗначениеЗаполнено(CURRENT_CERTIFICATE_PASSWORD) Тогда
		НовыйМенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = CURRENT_CERTIFICATE_PASSWORD;
	КонецЕсли;
	 
	Возврат НовыйМенеджерКриптографии;

КонецФункции

// Подписывает двоичные данные сертификатом текущей организации.
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - данные для подписи
//
// Возвращаемое значение:
//   ДвоичныеДанные - подпись
Функция МенеджерКриптографии_Подписать(ДвоичныеДанные)

	МенеджерКриптографии = МенеджерКриптографии_Новый();
	Возврат МенеджерКриптографии.Подписать(ДвоичныеДанные, CURRENT_CERTIFICATE);
	
КонецФункции

// Расшифровывает двоичные данные сертификатом текущей организации.
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - данные для расшифровки
//
// Возвращаемое значение:
