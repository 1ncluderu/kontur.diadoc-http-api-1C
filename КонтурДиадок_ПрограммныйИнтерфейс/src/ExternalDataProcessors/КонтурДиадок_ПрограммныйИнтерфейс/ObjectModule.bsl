// Добавляет в заголовки запроса заголовок авторизации.
//
// Параметры:
//   Заголовки - Соответствие из КлючИЗначение - заголовки запроса, в которые добавляется заголовок Authorization
//   НачальнаяАвторизация - Булево - Истина, если выполняется начальная авторизация по сертификату
Процедура ДобавитьЗаголовокАвторизации(Заголовки, НачальнаяАвторизация = Ложь)

	ПараметрыСтроки = Новый Структура();

	Если ORGANIZATION_INFO.АвторизацияOIDC Тогда

		Шаблон = "Bearer [ACCESS_TOKEN]";
		ПараметрыСтроки.Вставить("ACCESS_TOKEN", CURRENT_ACCESS_TOKEN.access_token);

	Иначе

		ПараметрыСтроки.Вставить("DDAUTH_API_CLIENT_ID", ORGANIZATION_INFO.КлючРазработчика);
		Если НачальнаяАвторизация Тогда
			Шаблон = "DiadocAuth ddauth_api_client_id=[DDAUTH_API_CLIENT_ID]";
		Иначе
			ПараметрыСтроки.Вставить("ACCESS_TOKEN", CURRENT_ACCESS_TOKEN.access_token);
			Шаблон = "DiadocAuth ddauth_api_client_id=[DDAUTH_API_CLIENT_ID], ddauth_token=[ACCESS_TOKEN]";
		КонецЕсли;

	КонецЕсли;

	Заголовки.Вставить("Authorization", СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыСтроки));

КонецПроцедуры

// Проверяет код состояния ответа и при необходимости фиксирует ошибку или вызывает исключение.
//
// Параметры:
//   Результат - Структура - результат HTTP-запроса, содержащий код состояния и тело ответа
Функция УспешноВыполненМетодHTTP(Результат)
	
	// https://httpwg.org/specs/rfc9110.html#status.2xx
	КодУспешногоВыполнения = Новый Соответствие();
	КодУспешногоВыполнения.Вставить(200, Истина);
	КодУспешногоВыполнения.Вставить(201, Истина);
	КодУспешногоВыполнения.Вставить(202, Истина);
	КодУспешногоВыполнения.Вставить(203, Истина);
	КодУспешногоВыполнения.Вставить(204, Истина);
	КодУспешногоВыполнения.Вставить(205, Истина);
	КодУспешногоВыполнения.Вставить(206, Истина);
	
	Возврат КодУспешногоВыполнения[Результат.КодСостояния] = Истина;
	
КонецФункции

// Возвращает параметры HTTP-метода для выполнения запроса через коннектор.
//
// Параметры:
//   Данные - Строка, ДвоичныеДанные - тело запроса
//   Json - Структура - данные для сериализации в JSON
//   ПараметрыЗапроса - Структура - параметры строки запроса
//
// Возвращаемое значение:
//   Структура - параметры метода коннектора HTTP
Функция НовыеПараметрыМетода(Данные = Неопределено, Json = Неопределено, ПараметрыЗапроса = Неопределено)

	НовыеПараметрыМетода = Модуль_КоннекторHTTP.НовыеПараметры();
	НовыеПараметрыМетода.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Ложь;

	Если Данные <> Неопределено Тогда
		НовыеПараметрыМетода.Данные = Данные;
	КонецЕсли;

	Если Json <> Неопределено Тогда
		НовыеПараметрыМетода.Json = Json;
	КонецЕсли;

	Если ПараметрыЗапроса <> Неопределено Тогда
		НовыеПараметрыМетода.ПараметрыЗапроса = ПараметрыЗапроса;
	КонецЕсли;

	Возврат НовыеПараметрыМетода;

КонецФункции

