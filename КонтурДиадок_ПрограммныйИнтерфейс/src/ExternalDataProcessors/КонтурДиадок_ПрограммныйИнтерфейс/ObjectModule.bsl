Функция ИдентификаторЯщика()

	Если Не ЗначениеЗаполнено(ORGANIZATION_INFO.ИдентификаторЯщика) Тогда
		ИдентификаторыЯщиков = ИдентификаторыЯщиков();
		Если ИдентификаторыЯщиков.Успешно И ИдентификаторыЯщиков.Данные.Количество() Тогда

			ORGANIZATION_INFO.ИдентификаторЯщика = ИдентификаторыЯщиков.Данные[0].ИдентификаторЯщика;

		КонецЕсли;
	КонецЕсли;

	Возврат ORGANIZATION_INFO.ИдентификаторЯщика;

