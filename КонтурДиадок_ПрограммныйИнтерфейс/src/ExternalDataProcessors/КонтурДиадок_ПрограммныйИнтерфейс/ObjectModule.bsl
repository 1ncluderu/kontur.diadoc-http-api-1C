// Возвращает сертификат из хранилища по его отпечатку.
//
// Параметры:
//   ОтпечатокСертификата - Строка, ДвоичныеДанные - отпечаток сертификата
//
// Возвращаемое значение:
//   СертификатКриптографии - найденный сертификат
//   - Неопределено - если сертификат не найден или не указан отпечаток
Функция МенеджерКриптографии_СертификатПоОтпечатку(Знач ОтпечатокСертификата)

	Если ТипЗнч(ОтпечатокСертификата) = Тип("Строка") Тогда
		
		Если ПустаяСтрока(ОтпечатокСертификата) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ОтпечатокСертификата = ПолучитьДвоичныеДанныеИзHexСтроки(ОтпечатокСертификата);
		
	КонецЕсли;

	Попытка

		МенеджерКриптографии = МенеджерКриптографии_Новый();
		ХранилищеСертификатовКриптографии = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ОтпечатокСертификата);

	Исключение
		Сертификат = Неопределено;
	КонецПопытки;

	Возврат Сертификат;

КонецФункции

// Возвращает сертификаты организации, найденные по ИНН, отсортированные по дате окончания действия.
//
// Параметры:
//   ИНН - Строка - ИНН организации
//
// Возвращаемое значение:
//   ТаблицаЗначений - сертификаты:
//     * Сертификат - СертификатКриптографии - сертификат
//     * ДатаОкончания - Дата - дата окончания действия сертификата
//   - Неопределено - если сертификаты не найдены
Функция МенеджерКриптографии_СертификатыПоИНН(ИНН)

	МенеджерКриптографии = МенеджерКриптографии_Новый();
	ХранилищеСертификатовКриптографии = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
		ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);

	СертификатыПоСубъекту = ХранилищеСертификатовКриптографии.НайтиПоСубъекту(ИНН);
	Если СертификатыПоСубъекту.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Заполняем ТаблицаЗначений для сортировки
	Сертификаты = Новый ТаблицаЗначений();
	Сертификаты.Колонки.Добавить("Сертификат");
	Сертификаты.Колонки.Добавить("ДатаОкончания");

	Для Каждого Сертификат Из СертификатыПоСубъекту Цикл

		НоваяСтрока = Сертификаты.Добавить();
		НоваяСтрока.Сертификат = Сертификат;
		НоваяСтрока.ДатаОкончания = Сертификат.ДатаОкончания;

	КонецЦикла;

	Сертификаты.Сортировать("ДатаОкончания УБЫВ");

	Возврат Сертификаты;

КонецФункции

// Возвращает сертификат организации с наиболее поздней датой окончания действия.
//
// Параметры:
//   ИНН - Строка - ИНН организации
//
// Возвращаемое значение:
//   СертификатКриптографии - найденный сертификат
//   - Неопределено - если сертификат не найден
Функция МенеджерКриптографии_СертификатПоИНН(ИНН)

	Сертификаты = МенеджерКриптографии_СертификатыПоИНН(ИНН);
	Если Сертификаты = Неопределено Тогда
		Возврат Сертификаты;
	КонецЕсли;

	Возврат ?(Сертификаты.Количество(), Сертификаты[0].Сертификат, Неопределено);

КонецФункции

