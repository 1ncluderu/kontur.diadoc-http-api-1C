// Сбрасывает переменные окружения модуля.
Процедура ОчиститьОкружение()

	СессияКоннектор = Неопределено;

	CURRENT_ORGANIZATION = Неопределено;
	CURRENT_CERTIFICATE = Неопределено;
	CURRENT_CERTIFICATE_PASSWORD = Неопределено;

	CURRENT_ACCESS_TOKEN = Неопределено;

	ORGANIZATION_INFO = Неопределено;

КонецПроцедуры

// Инициализирует переменные окружения модуля для текущей организации.
Процедура ИнициализироватьОкружение()
	
	// Уже инициализировано
	Если CURRENT_ORGANIZATION = Организация Тогда
		Возврат;
	КонецЕсли;

	ОчиститьОкружение();

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение(НСтр("ru = 'Не указана организация'", ОбщегоНазначения.КодОсновногоЯзыка()));
	КонецЕсли;

	CURRENT_ORGANIZATION = Организация;
	CURRENT_ACCESS_TOKEN = ИзвлечьТокен();
	ORGANIZATION_INFO = ИзвлечьИнформациюИнтеграции();

	CURRENT_CERTIFICATE_PASSWORD = ORGANIZATION_INFO.ПарольСертификата;

	Если ЗначениеЗаполнено(ORGANIZATION_INFO.ОтпечатокСертификата) Тогда

		CURRENT_CERTIFICATE = МенеджерКриптографии_СертификатПоОтпечатку(ORGANIZATION_INFO.ОтпечатокСертификата);

	ИначеЕсли ЗначениеЗаполнено(ORGANIZATION_INFO.ИНН) Тогда

		CURRENT_CERTIFICATE = МенеджерКриптографии_СертификатПоИНН(ORGANIZATION_INFO.ИНН);

	КонецЕсли;

КонецПроцедуры

