// Выполняет авторизацию в сервисе Контур.Диадок и сохраняет токен доступа.
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода 
Функция Авторизоваться() Экспорт
	
	ПродлеватьТокен = Ложь; 
	ПередНачаломВыполненияМетода(ПродлеватьТокен);
	
	Если ORGANIZATION_INFO.АвторизацияOIDC Тогда

		РезультатЗапроса = Connect(
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.client_id,
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.client_secret,
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.refresh_token
		);
		
		НовыйТокенДоступа = РезультатЗапроса.access_token;
			
	Иначе
		// Метод устарел, следует использовать OIDC авторизацию
		НовыйТокенДоступа = V3_AuthenticateConfirm(V3_Authenticate());
		
	КонецЕсли;
	
	CURRENT_ACESS_TOKEN = Контракт_CURRENT_ACESS_TOKEN();
	
	Если Ошибка Тогда
		
		РезультатВыполнения = РезультатОшибка();
		
	Иначе
		
		CURRENT_ACESS_TOKEN.expire_date = ТекущаяДатаСеанса() + 43200; // Меняем не через 24 часа, а через 12
		CURRENT_ACESS_TOKEN.acess_token = НовыйТокенДоступа;
		
		РезультатВыполнения = РезультатВыполненияМетода(Истина, НСтр("ru = 'Успешно авторизован'",
			ОбщегоНазначения.КодОсновногоЯзыка()));
			
	КонецЕсли;
	
	СохранитьТокен();
		
	Возврат РезультатВыполнения;
	
КонецФункции

#Область СписокКонтрагентов

// Возвращает список контрагентов организации с возможностью постраничного получения.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса:
//     * СтатусКонтрагента - Строка - статус контрагента ("IsMyCounteragent", "InvitesMe", "IsInvitedByMe", "Rejected")
//     * ИдентификаторСледующейПорции - Строка - ключ для постраничного получения списка
//     * СтрокаПоиска - Строка - текст для поиска по наименованию или ИНН
//     * РазмерСтраницы - Число - размер страницы, от 1 до 100
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода 
Функция СписокКонтрагентов(ПараметрыМетода) Экспорт
	
	ПередНачаломВыполненияМетода();
	
	counteragentStatus = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "СтатусКонтрагента", Неопределено);
	afterIndexKey = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИдентификаторСледующейПорции", Неопределено);
	query = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "СтрокаПоиска", Неопределено);
	pageSize = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "РазмерСтраницы", Неопределено);
	
	Если (pageSize <> Неопределено И pageSize > 100)
		Или (pageSize <> Неопределено И pageSize < 1) Тогда
		pageSize = Неопределено;	
	КонецЕсли;
	
	РезультатЗапроса = V3_GetCounteragents(counteragentStatus, afterIndexKey, query, pageSize);
	
	Если Ошибка Тогда
		РезультатВыполнения = РезультатОшибка();	
	Иначе
		ПараметрыЗапросаСледующейПорции = Новый Структура();
		ПараметрыЗапросаСледующейПорции.Вставить("СтатусКонтрагента", counteragentStatus);
		ПараметрыЗапросаСледующейПорции.Вставить("ИдентификаторСледующейПорции", ?(РезультатЗапроса.Counteragents.Количество(),
			РезультатЗапроса.Counteragents[РезультатЗапроса.Counteragents.ВГраница()].IndexKey, afterIndexKey));
		
		РезультатЗапроса.Вставить("ПараметрыЗапросаСледующейПорции", ПараметрыЗапросаСледующейПорции);
		
		РезультатВыполнения = РезультатВыполненияМетода(Истина, "Выполнено успешно", РезультатЗапроса);
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Возвращает следующую порцию списка контрагентов на основании результата предыдущего запроса.
//
// Параметры:
//   РезультатЗапросаСпискаКонтрагентов - Структура - результат предыдущего вызова метода СписокКонтрагентов
//
// Возвращаемое значение:
//   см. СписокКонтрагентов
Функция СписокКонтрагентовСледующаяПорция(РезультатЗапросаСпискаКонтрагентов) Экспорт
	
	Возврат СписокКонтрагентов(РезультатЗапросаСпискаКонтрагентов.Данные.ПараметрыЗапросаСледующейПорции);
	
КонецФункции

