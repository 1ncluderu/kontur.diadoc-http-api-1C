// Возвращает список контрагентов из сервиса Контур.Диадок.
//
// Параметры:
//   counteragentStatus - Строка - статус контрагента. Принимает значения:
//                        "IsMyCounteragent", "InvitesMe", "IsInvitedByMe", "Rejected"
//   afterIndexKey - Строка - ключ для постраничного получения списка, указывающий на начало очередной страницы.
//                  Нельзя указывать одновременно с query
//   query - Строка - текстовая строка для поиска организации по краткому или полному наименованию ящика контрагента или ИНН.
//           Нельзя указывать одновременно с afterIndexKey
//   pageSize - Число - максимальное количество контрагентов в ответе, от 1 до 100, по умолчанию 100
//
// Возвращаемое значение:
//   Структура - данные ответа сервиса:
//     * TotalCount - Число - количество найденных контрагентов, соответствующих заданным параметрам
//     * Counteragents - Массив - список контрагентов
//     * TotalCountType - Строка - параметр, указывающий, является ли значение TotalCount точным или подсчет был ограничен  
//
//@skip-check doc-comment-collection-item-type
//@skip-check method-too-many-params
Функция V3_GetCounteragents(counteragentStatus = Неопределено, afterIndexKey = Неопределено,
	query = Неопределено, pageSize = Неопределено)
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("myBoxId", ИдентификаторЯщика());
	
	Если ЗначениеЗаполнено(counteragentStatus) Тогда
		ПараметрыЗапроса.Вставить("counteragentStatus", counteragentStatus);
	КонецЕсли;

	Если ЗначениеЗаполнено(afterIndexKey) Тогда
		ПараметрыЗапроса.Вставить("afterIndexKey", afterIndexKey);
	КонецЕсли;
	
	// Одновременно использовать query и afterIndexKey нельзя
	Если ЗначениеЗаполнено(query)
		И Не ЗначениеЗаполнено(afterIndexKey) Тогда
		ПараметрыЗапроса.Вставить("query", query);
	КонецЕсли;

	Если ЗначениеЗаполнено(pageSize) Тогда
		ПараметрыЗапроса.Вставить("pageSize", pageSize);
	КонецЕсли;
	
	Параметры = НовыеПараметрыМетода(Неопределено, Неопределено, ПараметрыЗапроса);
	
	ДобавитьЗаголовокАвторизации(Параметры.Заголовки);

	Параметры.Заголовки.Вставить("Accept", "application/json");

	Результат = Модуль_КоннекторHTTP.Get(СтрШаблон("%1%2", АдресДиадокAPI(), "/V3/GetCounteragents"), Неопределено, Параметры, СессияКоннектор);
	ОбработатьКодСостоянияОтвета(Результат);

	Если Ошибка Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Модуль_КоннекторHTTP.КакJson(Результат, Параметры.ПараметрыПреобразованияJSON);

КонецФункции

