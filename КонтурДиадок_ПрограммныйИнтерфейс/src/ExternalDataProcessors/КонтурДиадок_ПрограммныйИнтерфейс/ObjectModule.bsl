// Возвращает список сертификатов организации с описанием их свойств.
//
// Возвращаемое значение:
//   Структура - результат выполнения:
//     * Успешно - Булево - Истина, если сертификаты получены
//     * ПредставлениеПользователю - Строка - текст сообщения для пользователя
//     * Данные - Массив из Структура, Неопределено - описание сертификатов:
//         ** ДатаНачалаДействия - Дата - дата начала действия сертификата
//         ** ДатаОкончанияДействия - Дата - дата окончания действия сертификата
//         ** ОтпечатокСертификата - Строка - отпечаток сертификата
//         ** ЮридическоеЛицо - Строка - наименование юридического лица
//         ** ФИО - Строка - ФИО владельца сертификата
Функция Сертификаты() Экспорт

	ПродлеватьТокен = Ложь;
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода(ПродлеватьТокен);
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;

	Сертификаты = МенеджерКриптографии_СертификатыПоИНН(ORGANIZATION_INFO.ИНН);
	Если Сертификаты = Неопределено Тогда
		Возврат РезультатВыполненияМетода(Ложь, "Сертификаты не найдены");
	КонецЕсли;

	ОписаниеСертификатов = Новый Массив();
	Для Каждого ЭлементКоллекции Из Сертификаты Цикл

		ОписаниеСертификата = Новый Структура();
		ОписаниеСертификата.Вставить("ДатаНачалаДействия", ЭлементКоллекции.Сертификат.ДатаНачала);
		ОписаниеСертификата.Вставить("ДатаОкончанияДействия", ЭлементКоллекции.Сертификат.ДатаОкончания);
		ОписаниеСертификата.Вставить("ОтпечатокСертификата", НРег(ПолучитьHexСтрокуИзДвоичныхДанных(
			ЭлементКоллекции.Сертификат.Отпечаток)));

		Если ЭлементКоллекции.Сертификат.Субъект.Свойство("CN") Тогда
			ОписаниеСертификата.Вставить("ЮридическоеЛицо", ЭлементКоллекции.Сертификат.Субъект.CN);
		ИначеЕсли ЭлементКоллекции.Сертификат.Субъект.Свойство("O") Тогда
			ОписаниеСертификата.Вставить("ЮридическоеЛицо", ЭлементКоллекции.Сертификат.Субъект.O);
		ИначеЕсли ЭлементКоллекции.Сертификат.Субъект.Свойство("OID2_5_4_10") Тогда
			ОписаниеСертификата.Вставить("ЮридическоеЛицо", ЭлементКоллекции.Сертификат.Субъект.OID2_5_4_10);
		ИначеЕсли ЭлементКоллекции.Сертификат.Субъект.Свойство("OID2_5_4_3") Тогда
			ОписаниеСертификата.Вставить("ЮридическоеЛицо", ЭлементКоллекции.Сертификат.Субъект.OID2_5_4_3);
		КонецЕсли;

		Если ЭлементКоллекции.Сертификат.Субъект.Свойство("SN") И ЭлементКоллекции.Сертификат.Субъект.Свойство("GN") Тогда
			ОписаниеСертификата.Вставить("ФИО", ЭлементКоллекции.Сертификат.Субъект.SN + " "
				+ ЭлементКоллекции.Сертификат.Субъект.GN);
		ИначеЕсли ЭлементКоллекции.Сертификат.Субъект.Свойство("OID2_5_4_4")
			И ЭлементКоллекции.Сертификат.Субъект.Свойство("OID2_5_4_42") Тогда
			ОписаниеСертификата.Вставить("ФИО", ЭлементКоллекции.Сертификат.Субъект.OID2_5_4_4 + " "
				+ ЭлементКоллекции.Сертификат.Субъект.OID2_5_4_42);
		КонецЕсли;

		ОписаниеСертификатов.Добавить(ОписаниеСертификата);

	КонецЦикла;

	Возврат РезультатВыполненияМетода(Истина, "Выполнено успешно", ОписаниеСертификатов);

КонецФункции

// Возвращает список ящиков организации в сервисе Контур.Диадок.
//
// Возвращаемое значение:
//   Структура - результат выполнения:
//     * Успешно - Булево - Истина, если ящики получены
//     * ПредставлениеПользователю - Строка - текст сообщения для пользователя
//     * Данные - Массив из Структура, Неопределено - описание ящиков:
//         ** НаименованиеЯщика - Строка - наименование ящика
//         ** ИдентификаторЯщика - Строка - идентификатор ящика
Функция ИдентификаторыЯщиков() Экспорт
	
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;

	РезультатВыполнения = GetMyOrganizations();
	Если Не РезультатВыполнения.Успешно Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	MyOrganizations = РезультатВыполнения.Данные;
	
	ИдентификаторыЯщиков = Новый Массив();
	Для Каждого MyOrganization Из MyOrganizations.Organizations Цикл
		Если MyOrganization.inn = ORGANIZATION_INFO.ИНН Тогда
			Для Каждого MyBox Из MyOrganization.Boxes Цикл

				ОписаниеЯщика = Новый Структура();
				ОписаниеЯщика.Вставить("НаименованиеЯщика", MyBox.Title);
				ОписаниеЯщика.Вставить("ИдентификаторЯщика", MyBox.BoxIdGuid);

				ИдентификаторыЯщиков.Добавить(ОписаниеЯщика);

			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатВыполненияМетода(Истина, "Выполнено успешно", ИдентификаторыЯщиков);

КонецФункции

