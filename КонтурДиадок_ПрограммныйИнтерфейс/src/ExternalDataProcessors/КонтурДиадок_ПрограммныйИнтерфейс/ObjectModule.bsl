#Область КонтурHTTP

// Возвращает результат обмена данных авторизации на токен доступа по протоколу OIDC.
//
// Параметры:
//   client_id - Строка - 
//   client_secret - Строка - 
//   refresh_token - Строка - 
//   grant_type - Строка - тип предоставления доступа
//
// Возвращаемое значение:
//   Структура - данные ответа сервиса авторизации
//   - Неопределено - если при выполнении запроса возникла ошибка
Функция Connect(client_id, client_secret, refresh_token, grant_type = "refresh_token")
	
	Данные = Новый Структура("client_id,client_secret,refresh_token,grant_type",
	                          client_id,client_secret,refresh_token,grant_type);
	
	Параметры = НовыеПараметрыМетода(Данные);
	Параметры.Заголовки.Вставить("Content-type", "application/x-www-form-urlencoded");
	
	Результат = Модуль_КоннекторHTTP.Post(СтрШаблон("%1/connect/token", АдресСервисаАвторизации()), Неопределено, Параметры, СессияКоннектор);
	ОбработатьКодСостоянияОтвета(Результат);
	
	Если Ошибка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Модуль_КоннекторHTTP.КакJson(Результат, Параметры.ПараметрыПреобразованияJSON);
	
КонецФункции

#Область УстаревшиеМетоды

// Возвращает зашифрованный токен аутентификации по сертификату (устаревший способ авторизации).
//
// Возвращаемое значение:
//   Строка - токен аутентификации в виде Base64-строки
Функция V3_Authenticate()
	
	Параметры = НовыеПараметрыМетода(Base64Строка(CURRENT_CERTIFICATE.Выгрузить()));
	Параметры.Заголовки.Вставить("Content-Type", "application/octet-stream");

	ДобавитьЗаголовокАвторизации(Параметры.Заголовки, Истина);

	Результат = Модуль_КоннекторHTTP.Post(СтрШаблон("%1%2", АдресДиадокAPI(), "/v3/Authenticate?type=certificate"),
		Неопределено, Параметры, СессияКоннектор);
	
	ОбработатьКодСостоянияОтвета(Результат);

	Возврат Base64Строка(МенеджерКриптографии_Расшифровать(Результат.Тело));

КонецФункции

// Подтверждает аутентификацию и возвращает токен доступа (устаревший способ авторизации).
//
// Параметры:
//   AuthenticateResult - Строка - токен аутентификации, полученный методом V3_Authenticate
//
// Возвращаемое значение:
//   Строка - токен доступа
Функция V3_AuthenticateConfirm(AuthenticateResult)
	
	ПараметрыЗапроса = Новый Структура("token,thumbprint",
		AuthenticateResult, ORGANIZATION_INFO.ОтпечатокСертификата);
	
	Параметры = НовыеПараметрыМетода(Неопределено, Неопределено, ПараметрыЗапроса);
	
	ДобавитьЗаголовокАвторизации(Параметры.Заголовки, Истина);

	Результат = Модуль_КоннекторHTTP.Post(СтрШаблон("%1%2", АдресДиадокAPI(), "/V3/AuthenticateConfirm"), Неопределено,
		Параметры, СессияКоннектор);
	ОбработатьКодСостоянияОтвета(Результат);

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Результат.Тело);
	
КонецФункции

