// Выполняет авторизацию в сервисе Контур.Диадок и сохраняет токен доступа.
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода 
Функция Авторизоваться() Экспорт

	ПродлеватьТокен = Ложь;
	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода(ПродлеватьТокен);
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;

	Если ORGANIZATION_INFO.АвторизацияOIDC Тогда

		РезультатВыполнения = Connect(
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.client_id, 
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.client_secret,
			ORGANIZATION_INFO.ДанныеАвторизацииOIDC.refresh_token);
	
	Иначе
		// Метод устарел, следует использовать OIDC авторизацию
		РезультатВыполнения = V3_Authenticate();
		Если РезультатВыполнения.Успешно Тогда
			РезультатВыполнения = V3_AuthenticateConfirm(РезультатВыполнения.Данные);
		КонецЕсли;
		
	КонецЕсли;
	
	CURRENT_ACCESS_TOKEN = Контракт_CURRENT_ACCESS_TOKEN();
	Если РезультатВыполнения.Успешно Тогда	
		
		CURRENT_ACCESS_TOKEN.expire_date = ТекущаяДатаСеанса() + 43200;
		CURRENT_ACCESS_TOKEN.access_token = ?(ORGANIZATION_INFO.АвторизацияOIDC,
			РезультатВыполнения.Данные.access_token, РезультатВыполнения.Данные);
		
		СохранитьТокен();
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

