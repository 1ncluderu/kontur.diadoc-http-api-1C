// Возвращает список документов, отфильтрованный по заданным параметрам.
//
// Параметры:
//   filterCategory - Строка - категория, по которой фильтруется список документов. Обязательный
//   counteragentBoxId - Строка - идентификатор ящика контрагента, используется для фильтрации.
//                       Не имеет смысла для внутренних документов
//   fromDepartmentId - Строка - идентификатор подразделения отправителя, используется для фильтрации.
//                      Имеет смысл только для внутренних документов
//   toDepartmentId - Строка - идентификатор подразделения получателя, используется для фильтрации.
//                    Имеет смысл только для внутренних документов
//   documentNumber - Строка - номер первичного документа
//   timestampFromTicks - Число - метка времени, задающая начальную точку периода фильтрации
//   timestampToTicks - Число - метка времени, задающая конечную точку периода фильтрации
//   fromDocumentDate - Строка - дата документа в формате "ДД.ММ.ГГГГ", задающая начальную точку периода фильтрации
//   toDocumentDate - Строка - дата документа в формате "ДД.ММ.ГГГГ", задающая конечную точку периода фильтрации
//   departmentId - Строка - идентификатор подразделения, в котором производится поиск документов.
//                  Если не указан, поиск производится в головном подразделении
//   excludeSubdepartments - Булево - Истина, если из поиска нужно исключить дочерние подразделения организации
//   afterIndexKey - Строка - ключ для постраничного получения списка найденных документов, указывающий на начало
//                   очередной страницы. Должен быть закодирован в URL-формат
//   sortDirection - Строка - порядок сортировки документов в ответе. Принимает значения
//                   "Ascending" или "Descending". По умолчанию "Ascending"
//   count - Число - максимальное количество элементов на одной странице ответа, от 0 до 100, по умолчанию 100.
//           Не влияет на общее количество найденных документов
//   
//filterCategory
//Параметр filterCategory задается строкой в формате <DocumentType>.<DocumentClass><DocumentStatus>.
//	<DocumentType> задает тип документа и принимает значения:
//		<TypeNamedId> - строковый идентификатор типа документа. Доступные типы можно получить с помощью метода GetDocumentTypes (V3). Например: Invoice, XmlAcceptanceCertificate, Nonformalized и т.п.
//		Any - агрегированный запрос для всех документов в ящике без учета по типу.
//<DocumentClass> задает класс документа и принимает значения:
//	Inbound - только входящие.
//	Outbound - только исходящие.
//	Internal - только внутренние.
//	Proxy - только документы, переданные через промежуточного получателя.
//	Deleted - только документы, помеченные удаленными.
//<DocumentStatus> задает статус документа и принимает значения:
//	Пустое значение - любой документ указанного класса.
//	NotRead - документ не прочитан.
//	NoRecipientSignatureRequest - документ без запроса ответной подписи.
//	WaitingForRecipientSignature - документ в ожидании ответной подписи.
//	WithRecipientSignature - документ с ответной подписью.
//	WithRecipientPartiallySignature - документ с ответной подписью с разногласиями.
//	WithSenderSignature - документ с подписью отправителя.
//	RecipientSignatureRequestRejected - документ с отказом от формирования ответной подписи.
//	WaitingForSenderSignature - документ, требующий подписания и отправки.
//	InvalidSenderSignature - документ с невалидной подписью отправителя, требующий повторного подписания и отправки.
//	InvalidRecipientSignature - документ с невалидной подписью получателя, требующий повторного подписания и отправки.
//	Approved - согласованный документ.
//	Disapproved - документ с отказом согласования.
//	WaitingForResolution - документ, находящийся на согласовании или подписи.
//	SignatureRequestRejected - документ с отказом в запросе подписи сотруднику.
//	Finished - документ с завершенным документооборотом.
//	HaveToCreateReceipt - нужно подписать извещение о получении.
//	NotFinished - документ с незавершенным документооборотом.
//	InvoiceAmendmentRequested - документ, по которому было запрошено уточнение.
//	RevocationIsRequestedByMe - документ, по которому было запрошено аннулирование.
//	RequestsMyRevocation - документ, по которому контрагент запросил аннулирование.
//	RevocationAccepted - аннулированный документ.
//	RevocationRejected - документ, запрос на аннулирование которого был отклонен.
//	RevocationApproved - документ, запрос на аннулирование которого был согласован.
//	RevocationDisapproved - документ с отказом согласования запроса на аннулирование.
//	WaitingForRevocationApprovement - документ, находящийся на согласовании запроса аннулирования.
//	NotRevoked - неаннулированный документ.
//	WaitingForProxySignature - документ в ожидании подписи промежуточного получателя.
//	WithProxySignature - документ с подписью промежуточного получателя.
//	InvalidProxySignature - документ с невалидной подписью промежуточного получателя, требующий повторного подписания и отправки.
//	ProxySignatureRejected - документ с отказом от формирования подписи промежуточным получателем.
//	WaitingForInvoiceReceipt - документ в ожидании получения извещения о получении счета-фактуры.
//	WaitingForReceipt - документ в ожидании получения извещения о получении.
//	RequestsMySignature - документ, по которому контрагент запросил подпись.
//	RoamingNotificationError - документ с ошибкой доставки в роуминге.
//	HaveToCancelTtGisFixation - документ, для которого требуется отмена сведений об отгрузке маркированных товаров.
//
//Примеры строки filterCategory:
//
//	Any.InboundNotRevoked - все входящие неаннулированные документы.
//	XmlTorg12.OutboundWithRecipientSignature - все исходящие формализованные ТОРГ-12, подписанные контрагентом.
//	InvoiceCorrection.OutboundInvoiceAmendmentRequested - все исходящие КСФ, по которым контрагент запросил уточнение.
//
Функция V3_GetDocuments(filterCategory,
	counteragentBoxId = Неопределено,
	fromDepartmentId = Неопределено,
	toDepartmentId = Неопределено,
	documentNumber = Неопределено,
	timestampFromTicks = Неопределено,
	timestampToTicks = Неопределено,
	fromDocumentDate = Неопределено,
	toDocumentDate = Неопределено,
	departmentId = Неопределено,
	excludeSubdepartments = Неопределено,
	afterIndexKey = Неопределено,
	sortDirection = Неопределено,
	count = 100)

	ПараметрыЗапроса = Новый Структура("boxId", ИдентификаторыЯщиков());
	Если counteragentBoxId <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("counteragentBoxId", counteragentBoxId);	
	КонецЕсли;
	
	Если fromDepartmentId <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("fromDepartmentId", fromDepartmentId);	
	КонецЕсли;
	
	Если toDepartmentId <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("toDepartmentId", toDepartmentId);	
	КонецЕсли;
	
	Если documentNumber <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("documentNumber", documentNumber);	
	КонецЕсли;
	
	Если timestampFromTicks <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("timestampFromTicks", timestampFromTicks);	
	КонецЕсли;
	
	Если timestampToTicks <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("timestampToTicks", timestampToTicks);	
	КонецЕсли;
	
	Если fromDocumentDate <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("fromDocumentDate", fromDocumentDate);	
	КонецЕсли;
	
	Если toDocumentDate <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("toDocumentDate", toDocumentDate);	
	КонецЕсли;
	
	Если departmentId <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("departmentId", departmentId);	
	КонецЕсли;
	
	Если excludeSubdepartments <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("excludeSubdepartments", excludeSubdepartments);	
	КонецЕсли;
	
	Если afterIndexKey <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("afterIndexKey", afterIndexKey);	
	КонецЕсли;
	
	Если sortDirection <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("sortDirection", sortDirection);	
	КонецЕсли;
	
	Если count <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("count", count);	
	КонецЕсли;
	
	Параметры = НовыеПараметрыМетода(Неопределено, Неопределено, ПараметрыЗапроса);

	ДобавитьЗаголовокАвторизации(Параметры.Заголовки);

	Параметры.Заголовки.Вставить("Accept", "application/json");
	
	Результат = Модуль_КоннекторHTTP.Get(СтрШаблон("%1%2", АдресДиадокAPI(), "/V3/GetDocuments"), Неопределено,
		Параметры, СессияКоннектор);
	
	Если Не УспешноВыполненМетодHTTP(Результат) Тогда
		Возврат РезультатВыполненияМетода(Ложь, Модуль_КоннекторHTTP.КакТекст(Результат));
	КонецЕсли;

	Возврат РезультатВыполненияМетода(Истина, "Выполнен успешно", 
		Модуль_КоннекторHTTP.КакJson(Результат, Параметры.ПараметрыПреобразованияJSON));
	
