#Область СписокДокументов

// Возвращает структуру с параметрами фильтрации списка документов.
//
// Возвращаемое значение:
//   Структура - параметры фильтрации:
//     * Категория - Строка - категория документов в формате <DocumentType>.<DocumentClass><DocumentStatus>
//     * ПоискПоДатамДокумента - Булево - Истина, если поиск выполняется по датам документа, иначе по меткам времени
//     * Контрагент - Структура - данные контрагента:
//         ** ИНН - Строка - ИНН контрагента
//         ** КПП - Строка - КПП контрагента
//         ** ИдентификаторЯщика - Строка - идентификатор ящика контрагента
//     * НачалоПериода - Дата - начало периода поиска
//     * КонецПериода - Дата - конец периода поиска
//     * ПодразделениеОтправителя - Строка, Неопределено - (необязательный) подразделение отправителя
//     * ПодразделениеПолучателя - Строка, Неопределено - (необязательный) подразделение получателя
//     * НомерПервичногоДокумента - Строка, Неопределено - (необязательный) номер первичного документа
//     * ПодразделениеПоиска - Строка, Неопределено - (необязательный) подразделение, в котором выполняется поиск
//     * ИдентификаторСледующейПорции - Строка, Неопределено - (необязательный) ключ для постраничного получения
//     * ИсключитьДочерниеПодразделенияПриПоиске - Булево - Истина, если из поиска исключаются дочерние подразделения
//     * ПорядокСортировки - Строка - порядок сортировки: "ВОЗР" или "УБЫВ"
//     * РазмерПорции - Число - размер страницы  
Функция Контракт_СписокДокументов() Экспорт
	
	Контрагент = Новый Структура();
	Контрагент.Вставить("ИНН", "");
	Контрагент.Вставить("КПП", "");
	Контрагент.Вставить("ИдентификаторЯщика", "");
	
	Контракт_СписокДокументов = Новый Структура();
	Контракт_СписокДокументов.Вставить("Категория", "Any.Inbound");
	Контракт_СписокДокументов.Вставить("ПоискПоДатамДокумента", Истина); // Если ложь, поиск идет по меткам времени
	Контракт_СписокДокументов.Вставить("Контрагент", Контрагент); 
	Контракт_СписокДокументов.Вставить("НачалоПериода", '00010101');
	Контракт_СписокДокументов.Вставить("КонецПериода", '00010101');
	Контракт_СписокДокументов.Вставить("ПодразделениеОтправителя", Неопределено);
	Контракт_СписокДокументов.Вставить("ПодразделениеПолучателя", Неопределено);
	Контракт_СписокДокументов.Вставить("НомерПервичногоДокумента", Неопределено);
	Контракт_СписокДокументов.Вставить("ПодразделениеПоиска", Неопределено);
	Контракт_СписокДокументов.Вставить("ИсключитьДочерниеПодразделенияПриПоиске", Истина);
	Контракт_СписокДокументов.Вставить("ИдентификаторСледующейПорции", Неопределено);
	Контракт_СписокДокументов.Вставить("ПорядокСортировки", "ВОЗР"); // "ВОЗР" или "УБЫВ"
	Контракт_СписокДокументов.Вставить("РазмерПорции", 100);
	
	Возврат Контракт_СписокДокументов;
	
