// Сохраняет токен доступа в безопасное хранилище.
Процедура СохранитьТокен()
	
	УстановитьПривилегированныйРежим(Истина);

	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(CURRENT_ORGANIZATION, CURRENT_ACESS_TOKEN,
		"Контур_ПрограммныйИнтерфейс_ТокенДоступа");
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

// Фиксирует текст ошибки и устанавливает признак наличия ошибки.
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки
Процедура ЗафиксироватьОшибку(ТекстОшибки)
	
	Ошибка = Истина;
	
	Если ТипЗнч(ТекстыОшибок) <> Тип("Массив") Тогда
		ТекстыОшибок = Новый Массив();	
	КонецЕсли;
	
	ТекстыОшибок.Добавить(ТекстОшибки);
	
КонецПроцедуры

// Возвращает результат выполнения метода с признаком ошибки.
//
// Параметры:
//   Данные - Произвольный - данные результата
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода
Функция РезультатОшибка(Данные = Неопределено)
	
	Возврат РезультатВыполненияМетода(Ложь, СтрСоединить(ТекстыОшибок, Символы.ПС), Данные);
	
КонецФункции

// Формирует структуру результата выполнения метода и сбрасывает состояние ошибок.
//
// Параметры:
//   Успешно - Булево - признак успешного выполнения
//   ПредставлениеПользователю - Строка - текст сообщения для пользователя
//   Данные - Произвольный - данные результата
//
// Возвращаемое значение:
//   Структура - результат выполнения:
//     * Успешно - Булево - признак успешного выполнения
//     * ПредставлениеПользователю - Строка - текст сообщения для пользователя
//     * Данные - Произвольный, Неопределено - данные результата
Функция РезультатВыполненияМетода(Успешно, ПредставлениеПользователю = "", Данные = Неопределено)
	
	РезультатУспех = Новый Структура("Успешно,ПредставлениеПользователю,Данные", Успешно, ПредставлениеПользователю, Данные);
	
	Ошибка = Ложь;
	ТекстыОшибок = Новый Массив();

	//@skip-check constructor-function-return-section
	Возврат РезультатУспех;
	
КонецФункции

// Инициализирует окружение и при необходимости продлевает токен доступа перед выполнением метода.
//
// Параметры:
//   ПродлеватьТокен - Булево - Истина, если нужно продлить токен при его истечении
Процедура ПередНачаломВыполненияМетода(ПродлеватьТокен = Истина)
	
	ИнициализироватьОкружение();
	
	Если CURRENT_ACESS_TOKEN.expire_date < ТекущаяДатаСеанса()
		И ПродлеватьТокен Тогда
		Авторизоваться();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

Ошибка = Ложь;
Если Модуль_КоннекторHTTP = Неопределено Тогда
	
	ЗащитаОтОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий();
	ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(ПолучитьМакет("КоннекторHTTP"), Новый УникальныйИдентификатор());
	ИмяЭкземпляра = ВнешниеОбработки.Подключить(АдресВХранилище, "КоннекторHTTP", Ложь, ЗащитаОтОпасныхДействий, );
	
	Модуль_КоннекторHTTP = ВнешниеОбработки.Создать(ИмяЭкземпляра, Ложь, ЗащитаОтОпасныхДействий);
		
КонецЕсли;

#КонецОбласти

#КонецЕсли