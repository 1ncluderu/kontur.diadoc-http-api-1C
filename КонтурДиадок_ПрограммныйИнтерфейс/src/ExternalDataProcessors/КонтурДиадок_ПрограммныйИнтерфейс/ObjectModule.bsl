#Область СписокКонтрагентов

// Возвращает список контрагентов организации с возможностью постраничного получения.
//
// Параметры:
//   ПараметрыМетода - Структура - параметры запроса:
//     * СтатусКонтрагента - Строка - (необязательный) статус контрагента ("IsMyCounteragent", "InvitesMe", "IsInvitedByMe", "Rejected")
//     * ИдентификаторСледующейПорции - Строка - (необязательный) ключ для постраничного получения списка
//     * СтрокаПоиска - Строка - (необязательный) текст для поиска по наименованию или ИНН
//     * РазмерСтраницы - Число - (необязательный) размер страницы, от 1 до 100
//
// Возвращаемое значение:
//   см. РезультатВыполненияМетода 
Функция СписокКонтрагентов(ПараметрыМетода) Экспорт

	РезультатНачальнойИнициализации = ПередНачаломВыполненияМетода();
	Если Не РезультатНачальнойИнициализации.Успешно Тогда
		Возврат РезультатНачальнойИнициализации;
	КонецЕсли;

	ПолныйСписок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ПолныйСписок", Новый Массив());

	counteragentStatus = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "СтатусКонтрагента", Неопределено);
	afterIndexKey = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "ИдентификаторСледующейПорции", Неопределено);
	query = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "СтрокаПоиска", Неопределено);
	pageSize = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыМетода, "РазмерСтраницы", Неопределено);

	Если (pageSize <> Неопределено И pageSize > 100) Или (pageSize <> Неопределено И pageSize < 1) Тогда
		pageSize = Неопределено;
	КонецЕсли;

	РезультатВыполнения = V3_GetCounteragents(counteragentStatus, afterIndexKey, query, pageSize);
	Если РезультатВыполнения.Успешно Тогда
		
		РезультатЗапроса = РезультатВыполнения.Данные;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПолныйСписок, РезультатЗапроса.Counteragents);

		ПараметрыЗапросаСледующейПорции = Новый Структура();
		ПараметрыЗапросаСледующейПорции.Вставить("СтатусКонтрагента", counteragentStatus);
		ПараметрыЗапросаСледующейПорции.Вставить("ИдентификаторСледующейПорции", ?(
		РезультатЗапроса.Counteragents.Количество(),
			РезультатЗапроса.Counteragents[РезультатЗапроса.Counteragents.ВГраница()].IndexKey, afterIndexKey));

		СписокКонтрагентов = Новый Структура();
		СписокКонтрагентов.Вставить("Контрагенты", ПолныйСписок);
		СписокКонтрагентов.Вставить("ЕстьЕще", РезультатЗапроса.TotalCount <> 0);
		СписокКонтрагентов.Вставить("ПараметрыЗапросаСледующейПорции", ПараметрыЗапросаСледующейПорции);
		
		РезультатВыполнения.Данные = СписокКонтрагентов;
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;

КонецФункции

// Возвращает следующую порцию списка контрагентов на основании результата предыдущего запроса.
//
// Параметры:
//   РезультатЗапросаСпискаКонтрагентов - Структура - результат предыдущего вызова метода СписокКонтрагентов
//
// Возвращаемое значение:
//   см. СписокКонтрагентов
Функция СписокКонтрагентовСледующаяПорция(РезультатЗапросаСпискаКонтрагентов) Экспорт

	Если Не РезультатЗапросаСпискаКонтрагентов.Данные.ПараметрыЗапросаСледующейПорции.Свойство("ПолныйСписок") Тогда
		РезультатЗапросаСпискаКонтрагентов.Данные.ПараметрыЗапросаСледующейПорции.Вставить("ПолныйСписок",
			Новый Массив());
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		РезультатЗапросаСпискаКонтрагентов.Данные.ПараметрыЗапросаСледующейПорции.ПолныйСписок,
		РезультатЗапросаСпискаКонтрагентов.Данные.Контрагенты);

	Возврат СписокКонтрагентов(РезультатЗапросаСпискаКонтрагентов.Данные.ПараметрыЗапросаСледующейПорции);

КонецФункции

