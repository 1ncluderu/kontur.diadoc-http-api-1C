// Возвращает результат обмена данных авторизации на токен доступа по протоколу OIDC.
//
// Параметры:
//   client_id - Строка - идентификатор клиента
//   client_secret - Строка - секрет клиента
//   refresh_token - Строка - токен обновления
//   grant_type - Строка - тип предоставления доступа
//
// Возвращаемое значение:
//   Структура - результат выполнения:
//     * Успешно - Булево - Истина, если запрос выполнен успешно
//     * ПредставлениеПользователю - Строка - текст сообщения для пользователя
//     * Данные - Произвольный, Неопределено - данные ответа сервиса авторизации
Функция Connect(client_id, client_secret, refresh_token, grant_type = "refresh_token")

	Данные = Новый Структура();
	Данные.Вставить("client_id", client_id);
	Данные.Вставить("client_secret", client_secret);
	Данные.Вставить("refresh_token", refresh_token);
	Данные.Вставить("grant_type", grant_type);
	
	Параметры = НовыеПараметрыМетода(Данные);
	Параметры.Заголовки.Вставить("Content-type", "application/x-www-form-urlencoded");

	Результат = Модуль_КоннекторHTTP.Post(СтрШаблон("%1/connect/token", АдресСервисаАвторизации()), Неопределено,
		Параметры, СессияКоннектор);
	
	Если Не УспешноВыполненМетодHTTP(Результат) Тогда
		Возврат РезультатВыполненияМетода(Ложь, Модуль_КоннекторHTTP.КакТекст(Результат));	
	КонецЕсли;

	Возврат РезультатВыполненияМетода(Истина, "Выполнен успешно", Модуль_КоннекторHTTP.КакJson(Результат, Параметры.ПараметрыПреобразованияJSON));

КонецФункции

